{
    "name": "macc/common-bundle",
    "description": "Servicios, comandos y clases compartidas para proyectos del Ministerio de Ambiente y Cambio Climático",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": ["symfony", "bundle", "macc", "utilities"],
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^3.0",
        "doctrine/orm": "^3.6",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/security-bundle": "^7.4",
        "doctrine/doctrine-bundle": "^2.19"
    },
    "autoload": {
        "psr-4": {
            "Macc\\CommonBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Macc\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    }
}
